<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Bottom sheet theme -->
    <style name="Theme.ABAPayWay.BottomSheet" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.ABAPayWay.BottomSheet</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Widget.ABAPayWay.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ABAPayWay.BottomSheet</item>
        <item name="backgroundTint">@color/payment_sheet_background</item>
    </style>

    <style name="ShapeAppearance.ABAPayWay.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
    </style>

    <!-- WebView theme -->
    <style name="Theme.ABAPayWay.WebView" parent="Theme.Material3.Light.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- Dialog theme -->
    <style name="Theme.ABAPayWay.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
</resources>