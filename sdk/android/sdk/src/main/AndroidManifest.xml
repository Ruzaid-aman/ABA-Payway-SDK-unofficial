<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ababank.payway">

    <!-- Network permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Query for ABA Mobile app (required for canOpenURL check) -->
    <queries>
        <package android:name="com.paygo24.ibank" />
        <package android:name="com.abacbank.mobiledevice" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="abamobilebank" />
        </intent>
    </queries>

    <application>

        <!-- Payment Sheet Activity -->
        <activity
            android:name=".ui.PaymentSheetActivity"
            android:exported="false"
            android:theme="@style/Theme.ABAPayWay.BottomSheet"
            android:windowSoftInputMode="adjustResize" />

        <!-- Checkout WebView Activity -->
        <activity
            android:name=".checkout.CheckoutWebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.ABAPayWay.WebView"
            android:windowSoftInputMode="adjustResize" />

        <!-- QR Display Dialog Activity -->
        <activity
            android:name=".ui.QRDisplayActivity"
            android:exported="false"
            android:theme="@style/Theme.ABAPayWay.Dialog" />

        <!-- Deep link handling: yourapp://payway/callback -->
        <activity
            android:name=".deeplink.DeeplinkInterceptorActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="yourapp"
                    android:host="payway"
                    android:pathPrefix="/callback" />
            </intent-filter>
        </activity>
    </application>