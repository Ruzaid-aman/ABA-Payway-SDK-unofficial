# ── Demo mode (default) ──────────────────────────────────────────
# Leave PAYWAY_MERCHANT_ID / PAYWAY_API_KEY unset: the app runs a local
# simulator, delivers real signed callbacks to itself, and labels every
# artifact SIMULATED. No network egress, no credentials.

PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000
ORDER_STORE_FILE=first-payment-store.json

# ── Sandbox mode (real PayWay sandbox) ───────────────────────────
# Uncomment and fill in. PUBLIC_BASE_URL must be the URL PayWay can push
# callbacks to — locally that only works for the demo gateway; use a public
# HTTPS host (tunnel, staging box) for real sandbox callbacks.
#
# PAYWAY_ENV=sandbox
# PAYWAY_MERCHANT_ID=your-sandbox-merchant-id
# PAYWAY_API_KEY=your-sandbox-api-key
# PUBLIC_BASE_URL=https://your-public-host.example
