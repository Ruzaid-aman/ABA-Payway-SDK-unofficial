# Example app working state (runtime artifacts)
first-payment-store.json
first-payment-store.json.tmp
*.log

# The root .gitignore's .env.* pattern would swallow the template — keep it tracked.
!.env.example

# Vendored SDK tarball — regenerated by `npm run setup`
vendor/

# Local dependency install
node_modules/

# Lockfile is generated by setup against the local tarball; it pins a
# machine-specific tarball hash, so it is not committed. When the SDK is
# published, switch the dependency to a registry version and commit the lockfile.
package-lock.json
