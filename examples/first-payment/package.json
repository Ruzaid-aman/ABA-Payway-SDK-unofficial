{
  "name": "payway-first-payment-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portable first-payment reference app for aba-payway-ts: QR + hosted-card tabs, verified callbacks, idempotent fulfillment, refunds, and reconciliation.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --experimental-strip-types --no-warnings src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm --prefix ../.. test -- src/__tests__/first-payment-examples.test.ts"
  },
  "dependencies": {
    "aba-payway-ts": "file:vendor/aba-payway-ts.tgz",
    "payway-first-payment-example": "file:"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  }
}
