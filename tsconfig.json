{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "rootDir": ".",
    "outDir": "./dist/sdk",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "src/__tests__/**/*"]
}
