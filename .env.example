# ABA PayWay SDK — complete environment-variable reference (GENERATED).
#
# Emitted deterministically by scripts/generate/gen-env-vars.ts from
# knowledge/rules/env-vars.yaml. Regenerate with `npm run gen:env-vars` —
# do not edit by hand.
#
# Copy to `.env` and fill in the values you need. `.env` holds real
# credentials and is git-ignored; THIS file is the only env file that
# should ever be committed.
#
# Secret variables below are placeholders — NEVER commit real values.

# -------------------------------------------------------------------------
# Connection
# -------------------------------------------------------------------------

# PAYWAY_ENV — REQUIRED. Target environment: sandbox, production, or an https base URL (a URL
# value is honored as the API base URL and takes precedence over PAYWAY_SANDBOX).
#   Kind: non-secret (required)
#   Default: sandbox
PAYWAY_ENV=sandbox

# PAYWAY_SANDBOX — Legacy environment switch for the SDK client: 'true' resolves the sandbox
# endpoint, 'false' resolves production. Ignored when PAYWAY_ENV is sandbox/production/a URL.
#   Kind: non-secret
#   Default: true
PAYWAY_SANDBOX=true

# PAYWAY_BASE_URL — Overrides the API base URL for the SDK client (highest-priority URL source
# after explicit constructor config). Useful for the ABA Mobile Simulator or a local mock.
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_BASE_URL=https://api-example.sandbox.payway.com.kh
PAYWAY_BASE_URL=

# PAYWAY_TIMEOUT — Request timeout in milliseconds for SDK API calls (integer). Unset uses the SDK
# default of 30000 ms; non-positive or non-numeric values throw a PayWayConfigError.
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_TIMEOUT=30000
PAYWAY_TIMEOUT=

# PAYWAY_STRICT_VALIDATION — '1' or 'true' enables SDK strict local validation (tighter request
# checks before any network call).
#   Kind: non-secret
#   Default: 0
PAYWAY_STRICT_VALIDATION=0

# PAYWAY_PROFILE — Selects the active CLI profile from the user profile store when no --profile
# flag is given (agent REPL, session shell, and top-level commands all honor it).
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_PROFILE=

# -------------------------------------------------------------------------
# Credentials
# -------------------------------------------------------------------------

# PAYWAY_MERCHANT_ID — REQUIRED. ABA-issued merchant ID (MID) used to sign every
# merchant-authenticated API request. Required together with PAYWAY_API_KEY.
#   Kind: credential (required)
#   Default: unset (built-in default applies)
#   Example: PAYWAY_MERCHANT_ID=ec476910
PAYWAY_MERCHANT_ID=

# PAYWAY_API_KEY — REQUIRED. ABA-issued merchant API key used for HMAC request signing and
# callback verification. Never commit a real value; .env is git-ignored.
#   Kind: secret (required)
#   Default: unset (built-in default applies)
#   NEVER COMMIT A REAL VALUE — replace the placeholder below out-of-band.
PAYWAY_API_KEY=

# PAYWAY_RSA_PUBLIC_KEY — ABA-issued RSA PUBLIC key (PEM). Required for refund, pre-auth,
# payout/beneficiary, payment-link and COF operations. Single-line values with literal \n escapes
# and multi-line quoted PEMs are both supported by the CLI .env loader.
#   Kind: credential
#   Default: unset (built-in default applies)
#   The CLI .env loader accepts both forms (the quotes make it fold \n escapes):
#     single-line (quoted, literal \n escapes): PAYWAY_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A\n-----END PUBLIC KEY-----"
#     multi-line (quoted):
#       PAYWAY_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
#       MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA0Z8QhXrSAMPLE-KEY-BODY
#       -----END PUBLIC KEY-----"
PAYWAY_RSA_PUBLIC_KEY=

# PAYWAY_PARTNER_ID — Partner ID for merchant self-activation endpoints (requestWithPartnerAuth).
# A partner-only configuration can construct the SDK and call partner endpoints without merchant
# credentials.
#   Kind: credential
#   Default: unset (built-in default applies)
#   Example: PAYWAY_PARTNER_ID=partner-0001
PAYWAY_PARTNER_ID=

# PAYWAY_PARTNER_API_KEY — Partner API key for self-activation endpoints (SHA256 HMAC; the
# get-mc-credential-info leg uses SHA512). Never commit a real value.
#   Kind: secret
#   Default: unset (built-in default applies)
#   NEVER COMMIT A REAL VALUE — replace the placeholder below out-of-band.
PAYWAY_PARTNER_API_KEY=

# -------------------------------------------------------------------------
# URLs (return / cancel / callback)
# -------------------------------------------------------------------------

# PAYWAY_RETURN_URL — REQUIRED. Default customer return URL after checkout. Required when
# launching checkout (validatePayWayEnv reports a blocking error when missing); the CLI uses it as
# the fallback for the matching --return-url flag.
#   Kind: non-secret (required)
#   Default: unset (built-in default applies)
#   Example: PAYWAY_RETURN_URL=https://yoursite.com/payment/return
PAYWAY_RETURN_URL=

# PAYWAY_CANCEL_URL — Customer cancel URL for hosted checkout. Must be an http(s) URL when set;
# the CLI uses it as the fallback for the matching --cancel-url flag.
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_CANCEL_URL=https://yoursite.com/payment/cancel
PAYWAY_CANCEL_URL=

# PAYWAY_CALLBACK_URL — Server-to-server callback URL (transaction pushback, COF linking, webhook
# workbench). Must be publicly reachable; verify incoming callbacks with the X-PAYWAY-HMAC-SHA512
# header.
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_CALLBACK_URL=https://yoursite.com/api/payment/callback
PAYWAY_CALLBACK_URL=

# -------------------------------------------------------------------------
# TLS (certificate verification)
# -------------------------------------------------------------------------

# PAYWAY_TLS_CA_FILE — Path to a PEM CA bundle used to verify the PayWay endpoint certificate
# (DX-SEC-001: the safe replacement for the legacy TLS-verification bypass).
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_TLS_CA_FILE=./certs/payway-sandbox-ca.pem
PAYWAY_TLS_CA_FILE=

# PAYWAY_TLS_MIN_VERSION — Minimum TLS protocol version for SDK requests: TLSv1, TLSv1.1, TLSv1.2,
# or TLSv1.3. Anything else throws a PayWayConfigError.
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_TLS_MIN_VERSION=TLSv1.2
PAYWAY_TLS_MIN_VERSION=

# -------------------------------------------------------------------------
# Behavior toggles
# -------------------------------------------------------------------------

# PAYWAY_UI — CLI presentation mode: 'classic' forces the legacy plain output on real TTYs too;
# anything else auto-selects the interactive TUI (agents/CI and pipes always stay classic).
#   Kind: non-secret
#   Default: auto
PAYWAY_UI=auto

# PAYWAY_ADVISORY_IGNORE — Comma-separated advisory rule ids (e.g. 'QR-016,GW-CAP-EMAIL') to
# suppress entirely — no warning, no session collection, and no strictValidation escalation.
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_ADVISORY_IGNORE=

# PAYWAY_LOG_LEVEL — SDK log level: debug, info, warn, or error. Unset resolves to info (debug
# when the legacy debug config/DEBUG_PAYWAY flag is set).
#   Kind: non-secret
#   Default: info
PAYWAY_LOG_LEVEL=info

# PAYWAY_NO_UPDATE_CHECK — '1' disables the CLI's once-per-day update check (which only runs on
# interactive TTYs anyway).
#   Kind: non-secret
#   Default: 0
PAYWAY_NO_UPDATE_CHECK=0

# PAYWAY_ONBOARD_AUTO — '1' launches the interactive onboarding wizard automatically on the first
# unconfigured CLI command (interactive TTYs only). Opt-in.
#   Kind: non-secret
#   Default: 0
PAYWAY_ONBOARD_AUTO=0

# PAYWAY_MCP_ALLOW_MUTATIONS — '1' registers the mutating MCP tools (the MCP server is read-only
# by default). Equivalent to the --allow-mutations CLI flag.
#   Kind: non-secret
#   Default: 0
PAYWAY_MCP_ALLOW_MUTATIONS=0

# PAYWAY_AGENT_NO_RECOVER_HINT — Set to suppress the agent REPL's recovery hint when the inference
# provider fails to propose a plan.
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_AGENT_NO_RECOVER_HINT=

# PAYWAY_JOURNAL — Journal recording switch. SDK library: opt-in ('1'/'true'/'yes'/'on'). CLI: API
# commands record by default; PAYWAY_JOURNAL=0 (or --no-journal) opts out.
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_JOURNAL=

# PAYWAY_JOURNAL_MODE — Journal record detail: 'digest' (default — non-secret fields only) or
# 'full' (complete payloads; never journal secrets).
#   Kind: non-secret
#   Default: digest
PAYWAY_JOURNAL_MODE=digest

# PAYWAY_JOURNAL_MAX_AGE_DAYS — Retention guard: journal events older than this many days are
# pruned on write (best-effort, never blocks the emitting call). Unset disables age-based pruning.
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_JOURNAL_MAX_AGE_DAYS=90
PAYWAY_JOURNAL_MAX_AGE_DAYS=

# PAYWAY_FORCE_JSON_STORAGE — '1' forces the JSON file storage backend even when better-sqlite3 is
# importable (the SQLite default is one shared <data root>/payway.db).
#   Kind: non-secret
#   Default: 0
PAYWAY_FORCE_JSON_STORAGE=0

# -------------------------------------------------------------------------
# Data directories (local stores)
# -------------------------------------------------------------------------

# PAYWAY_DATA_DIR — Overrides the shared data root for every local store (journal.jsonl,
# linked-tokens.json, webhook_data/, payway.db). Default: <APPDATA|~/.config>/aba-payway-sdk/data.
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_DATA_DIR=

# PAYWAY_JOURNAL_DIR — Journal directory override (default: the PAYWAY_DATA_DIR data root).
# Precedence: explicit --dir arg > this variable > the data root.
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_JOURNAL_DIR=

# PAYWAY_WEBHOOK_DIR — Webhook capture directory override (default: <data root>/webhook_data). The
# webhook workbench stores signed captures here for resend/verify.
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_WEBHOOK_DIR=

# PAYWAY_TOKEN_STORE_DIR — COF linked-token store directory override (default: the PAYWAY_DATA_DIR
# data root; tokens live in linked-tokens.json).
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_TOKEN_STORE_DIR=

# PAYWAY_KNOWLEDGE_DIR — Overrides the knowledge-base directory (the packaged knowledge/ corpus
# with MANIFEST.json). Default resolves relative to the executable, then ./knowledge from the
# working directory.
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_KNOWLEDGE_DIR=

# -------------------------------------------------------------------------
# Integrations (agent REPL, KHQR)
# -------------------------------------------------------------------------

# PAYWAY_AGENT_API_KEY — Inference-provider API key for the agent REPL (`payway-sdk agent`). The
# CLI never stores, logs, or accepts this key as an argument — it is read from the environment
# only and redacted from all agent output.
#   Kind: secret
#   Default: unset (built-in default applies)
#   NEVER COMMIT A REAL VALUE — replace the placeholder below out-of-band.
PAYWAY_AGENT_API_KEY=

# PAYWAY_AGENT_BASE_URL — Base URL for the agent REPL's inference provider (documented contract
# for self-hosted/proxied OpenAI-compatible endpoints; the in-repo provider adapter currently
# receives baseUrl via its config object, so no direct process.env read exists — registered so
# setting it is never reported as unrecognized).
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_AGENT_BASE_URL=

# PAYWAY_KHQR_BAKONG_ID — Bakong account ID (user@bakong) for ABA KHQR generation — part of the
# nested merchant-account template (max 32 UTF-8 bytes).
#   Kind: credential
#   Default: unset (built-in default applies)
#   Example: PAYWAY_KHQR_BAKONG_ID=merchant@bakong
PAYWAY_KHQR_BAKONG_ID=

# PAYWAY_KHQR_ABA_MERCHANT_ID — ABA merchant ID embedded in the KHQR merchant-account template
# (exactly 15 digits).
#   Kind: credential
#   Default: unset (built-in default applies)
#   Example: PAYWAY_KHQR_ABA_MERCHANT_ID=000000000000000
PAYWAY_KHQR_ABA_MERCHANT_ID=

# PAYWAY_KHQR_ACQUIRER_NAME — Acquirer name for the KHQR merchant-account template (max 32 UTF-8
# bytes).
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_KHQR_ACQUIRER_NAME=ABA Bank
PAYWAY_KHQR_ACQUIRER_NAME=

# PAYWAY_KHQR_MERCHANT_CATEGORY_CODE — KHQR merchant category code (exactly 4 digits, ISO 18245).
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_KHQR_MERCHANT_CATEGORY_CODE=5999
PAYWAY_KHQR_MERCHANT_CATEGORY_CODE=

# PAYWAY_KHQR_MERCHANT_NAME — KHQR merchant name (max 25 characters).
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_KHQR_MERCHANT_NAME=My Shop
PAYWAY_KHQR_MERCHANT_NAME=

# PAYWAY_KHQR_MERCHANT_CITY — KHQR merchant city (max 15 characters).
#   Kind: non-secret
#   Default: unset (built-in default applies)
#   Example: PAYWAY_KHQR_MERCHANT_CITY=Phnom Penh
PAYWAY_KHQR_MERCHANT_CITY=

# PAYWAY_KHQR_PAYWAY_DATA — ABA PayWay template string embedded in KHQR tag 62 (max 99 UTF-8
# bytes; must leave room for a 25-byte merchant reference).
#   Kind: non-secret
#   Default: unset (built-in default applies)
PAYWAY_KHQR_PAYWAY_DATA=

