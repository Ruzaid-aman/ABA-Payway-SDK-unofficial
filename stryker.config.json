{
  "$schema": "@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": [
    "json",
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "mutate": [
    "src/auth.ts",
    "src/circuit-breaker.ts"
  ],
  "tempDirName": "stryker-tmp",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  }
}
