{
  "name": "aba-payway-ts",
  "version": "1.5.0",
  "description": "Community-maintained, typed server-side SDK and CLI for the ABA PayWay payment gateway.",
  "license": "MIT",
  "author": "Antigravity <info@antigravity.dev> (https://antigravity.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antigravity-google/aba-payway-ts.git"
  },
  "bugs": {
    "url": "https://github.com/antigravity-google/aba-payway-ts/issues"
  },
  "homepage": "https://github.com/antigravity-google/aba-payway-ts#readme",
  "keywords": [
    "payway",
    "aba",
    "payment",
    "cambodia",
    "khqr",
    "fintech",
    "ecommerce",
    "typescript",
    "sdk",
    "ai-skills"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "payway-sdk": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills",
    "docs-packaged",
    "knowledge",
    "llms.txt",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:dist": "tsc --noEmit -p tsconfig.dist.json",
    "format:check": "biome format src",
    "gen:rules": "tsx scripts/generate/gen-rules.ts",
    "lint": "biome lint src skills",
    "lint:fix": "biome lint src --write",
    "format": "biome format src --write",
    "test": "vitest run --exclude src/__tests__/sandbox-contract.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sandbox": "node scripts/run-sandbox-contract.mjs",
    "docs:api": "typedoc --options typedoc.json",
    "gen:error-registry": "tsx scripts/generate-error-registry.ts",
    "sync:knowledge": "node scripts/sync-knowledge.mjs",
    "clean": "node scripts/clean.mjs",
    "check:package": "node --test scripts/lib/public-navigation.test.mjs && node scripts/check-package-contents.mjs",
    "check:public-docs": "node scripts/check-public-docs.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:secret-allowlists": "node scripts/check-secret-allowlists.mjs",
    "smoke:example": "node scripts/smoke-example.mjs",
    "smoke:package": "node scripts/smoke-packed-package.mjs",
    "prepublishOnly": "npm run clean && npm run sync:knowledge && npm run build",
    "bundle": "npx @redocly/cli bundle payway-openapi/openapi.yaml -o dist/openapi.bundled.yaml",
    "generate-types": "npx openapi-typescript dist/openapi.bundled.yaml -o src/types.ts",
    "probe": "npx tsx scripts/sandbox-probe.ts",
    "demo:zero-logic": "npx tsx scripts/zero-logic-purchase-flow.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@redocly/cli": "^1.25.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.10.6",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "qrcode": "^1.5.4",
    "undici": "^8.11.2",
    "yaml": "2.9.0"
  }
}
