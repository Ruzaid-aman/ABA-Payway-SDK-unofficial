{
  "name": "aba-payway-ts",
  "version": "1.3.0",
  "description": "Production-ready, fully-typed TypeScript SDK for the ABA PayWay payment gateway.",
  "license": "MIT",
  "author": "Antigravity <info@antigravity.dev> (https://antigravity.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antigravity-google/aba-payway-ts.git"
  },
  "bugs": {
    "url": "https://github.com/antigravity-google/aba-payway-ts/issues"
  },
  "homepage": "https://github.com/antigravity-google/aba-payway-ts#readme",
  "keywords": [
    "payway",
    "aba",
    "payment",
    "cambodia",
    "khqr",
    "fintech",
    "ecommerce",
    "typescript",
    "sdk",
    "ai-skills"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "payway-sdk": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "lint:fix": "biome lint src --write",
    "format": "biome format src --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sandbox": "node scripts/run-sandbox-contract.mjs",
    "docs:api": "npx typedoc --out docs/api src/index.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "bundle": "npx @redocly/cli bundle payway-openapi/openapi.yaml -o dist/openapi.bundled.yaml",
    "generate-types": "npx openapi-typescript dist/openapi.bundled.yaml -o src/types.ts",
    "probe": "npx tsx scripts/sandbox-probe.ts",
    "demo": "npx tsx scripts/zero-logic-purchase-flow.ts",
    "payway-sdk": "npx tsx scripts/zero-logic-purchase-flow.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@redocly/cli": "^1.25.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "canvas": "^3.2.3",
    "happy-dom": "^20.10.6",
    "openapi-typescript": "^7.13.0",
    "qrcode-reader": "^1.0.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "qrcode": "^1.5.4"
  }
}
