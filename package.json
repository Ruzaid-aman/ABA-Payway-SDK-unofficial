{
  "name": "aba-payway-ts",
  "version": "0.1.0",
  "description": "Production-ready, fully-typed TypeScript SDK for the ABA PayWay payment gateway.",
  "license": "MIT",
  "author": "Your Name <email@example.com> (https://yourwebsite.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antigravity-google/aba-payway-ts.git"
  },
  "keywords": [
    "payway",
    "aba",
    "payment",
    "cambodia",
    "khqr"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle": "npx @redocly/cli bundle payway-openapi/openapi.yaml -o dist/openapi.bundled.yaml",
    "generate-types": "npx openapi-typescript dist/openapi.bundled.yaml -o src/types.ts",
    "probe": "npx tsx scripts/sandbox-probe.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src",
    "format": "biome format src --write",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@redocly/cli": "^1.25.0",
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  }
}
