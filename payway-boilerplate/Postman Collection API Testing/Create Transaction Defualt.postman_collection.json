	"item": [
		{
			"name": "PayWay Create Transaction",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"//setting request_time value\r",
							"let d = new Date();\r",
							"let req_timeV = d.getFullYear().toString() + d.getMonth().toString() + d.getDate().toString() + d.getHours().toString() + d.getMinutes().toString() + d.getSeconds().toString();\r",
							"// let req_timeV = 'PAYOUT-20220428023252';\r",
							"pm.collectionVariables.set(\"req_timeV\", req_timeV);\r",
							"console.log(pm.collectionVariables.get(\"req_timeV\"));\r",
							"\r",
							"//setting merchant_id value\r",
							"let merchant_idV = \"plengbysmartkey\";\r",
							"pm.collectionVariables.set(\"merchant_idV\", merchant_idV);\r",
							"console.log(pm.collectionVariables.get(\"merchant_idV\"));\r",
							"\r",
							"\r",
							"//setting trand_id value\r",
							"let tran_idV = Date.now();\r",
							"// let tran_idV = '1628-sonitatest';\r",
							"pm.collectionVariables.set(\"tran_idV\", tran_idV.toString());\r",
							"console.log(pm.collectionVariables.get(\"tran_idV\"));\r",
							"\r",
							"//setting first Name value\r",
							"//let firstnameV = pm.variables.replaceIn('{{$randomFirstName}}');\r",
							"let firstnameV = 'tester-tester';\r",
							"pm.collectionVariables.set(\"firstnameV\", firstnameV);\r",
							"\r",
							"\r",
							"//setting Last Name value\r",
							"//let lastnameV =pm.variables.replaceIn('{{$randomWord}}') ;\r",
							"let lastnameV = 'tester tester';\r",
							"pm.collectionVariables.set(\"lastnameV\", lastnameV);\r",
							"\r",
							"\r",
							"\r",
							"//setting email value\r",
							"let emailV = \"chenda@gmail.com\";\r",
							"pm.collectionVariables.set(\"emailV\", emailV);\r",
							"\r",
							"//setting email value\r",
							"// let typeV =\"pre-auth\";\r",
							"// pm.collectionVariables.set(\"typeV\", typeV );\r",
							"\r",
							"\r",
							"let phoneV = \"+8551684415\";\r",
							"pm.collectionVariables.set(\"phoneV\", phoneV);\r",
							"\r",
							"let str = '{\"android_scheme\":\"https://web.whatsapp.com/\",\"ios_scheme\":\"https://web.whatsapp.com/\"}';\r",
							"let return_deeplinkV = btoa(str);\r",
							"// eyJhbmRyb2lkX3NjaGVtZSI6InRodHRwczovL3d3dy5wYXl3YXkuY29tLmtoL2RldmVsb3BlcnMvIn0=\r",
							"//eyJhbmRyb2lkX3NjaGVtZSI6Imh0dHBzOi8vd3d3LnBheXdheS5jb20ua2gvZGV2ZWxvcGVycy8ifQ==\r",
							"pm.collectionVariables.set(\"return_deeplinkV\", return_deeplinkV);\r",
							"console.log(\"this is return deeplink value \", pm.collectionVariables.get(\"return_deeplinkV\"));\r",
							"\r",
							"\r",
							"let return_paramsV = \"\";\r",
							"pm.collectionVariables.set(\"return_paramsV\", return_paramsV);\r",
							"//setting current price\r",
							"// let amountV =pm.variables.replaceIn('{{$randomPrice}}')\r",
							"let amountV = '0.01';\r",
							"pm.collectionVariables.set(\"amountV\", amountV);\r",
							"console.log(\"this is current amount value \", pm.collectionVariables.get(\"amountV\"));\r",
							"\r",
							"// let typeV = 'pre-auth';\r",
							"// pm.collectionVariables.set(\"typeV\", typeV );\r",
							"\r",
							"\r",
							"\r",
							"let payment_optionV = 'abapay_khqr_deeplink';\r",
							"pm.collectionVariables.set(\"payment_optionV\", payment_optionV);\r",
							"\r",
							"// let str = '{\"ios_scheme\":\"http://www.google.com\",\"android_scheme\":\"http://www.google.com\"}';\r",
							"// let return_deeplinkV = btoa(str);\r",
							"// console.log(return_deeplinkV); \r",
							"// let return_deeplinkV = \"\";\r",
							"// pm.collectionVariables.set(\"return_deeplinkV\", return_deeplinkV );\r",
							"// let payoutV = \"W3siYWNjIjoiMDAzMjI0OTQ4IiwiYW10IjoiMjAwMDAwIn0seyJhY2MiOiIwMDMyMjI0ODkiLCJhbXQiOiI2NTUwMCJ9LHsiYWNjIjoiMDAzMjIyNDk0IiwiYW10IjoiMTAwMDAwIn1d\";\r",
							"// pm.collectionVariables.set(\"payoutV\", payoutV );\r",
							"//calculate hash\r",
							"let hashMsg = req_timeV + merchant_idV + tran_idV + amountV + firstnameV + lastnameV + emailV + phoneV + payment_optionV + return_deeplinkV + return_paramsV.toString();\r",
							"pm.collectionVariables.set(\"hashMsg\", hashMsg);\r",
							"\r",
							"console.log(\"This is hash message\", pm.collectionVariables.get(\"hashMsg\"));\r",
							"\r",
							"let secret = pm.environment.get('PAYWAY_API_KEY');\r",
							"\r",
							"let crypto = require('crypto-js');\r",
							"\r",
							"let hashUnEnc = crypto.HmacSHA512(hashMsg, secret);\r",
							"pm.collectionVariables.set(\"hashUnEnc\", hashUnEnc);\r",
							"\r",
							"\r",
							"let hashV = crypto.enc.Base64.stringify(hashUnEnc);\r",
							"pm.collectionVariables.set(\"hashV\", hashV);\r",
							"\r",
							"console.log(\"This is hash Base encoded value \", pm.collectionVariables.get(\"hashV\"));\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
