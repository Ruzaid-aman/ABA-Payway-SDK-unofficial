			"name": "New Request",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let merchant_idV = \"dnwashanddry\";\r",
							"pm.collectionVariables.set(\"merchant_idV\", merchant_idV );\r",
							"console.log( pm.collectionVariables.get(\"merchant_idV\" ));\r",
							"\r",
							"\r",
							"//setting trand_id value\r",
							"// let tran_idV = Date.now();1651832575, 1651832799\r",
							"let tran_idV = 'ABAOrder-Goods-25692';//please input the tran_id here!!\r",
							"pm.collectionVariables.set(\"tran_idV\", tran_idV.toString() );\r",
							"console.log( pm.collectionVariables.get(\"tran_idV\" ) );\r",
							"\r",
							"let hashMsg = merchant_idV + tran_idV.toString() ;\r",
							"pm.collectionVariables.set(\"hashMsg\", hashMsg );\r",
							"\r",
							"console.log( \"This is hash message\", pm.collectionVariables.get(\"hashMsg\" ) );\r",
							"\r",
							"let secret = pm.environment.get('PAYWAY_API_KEY')\r",
							"\r",
							"let crypto = require('crypto-js');\r",
							"\r",
							"let hashUnEnc = crypto.HmacSHA512(hashMsg , secret);\r",
							"pm.collectionVariables.set(\"hashUnEnc\", hashUnEnc );\r",
							"\r",
							"//console.log( \"This is hash valune not encoded\", pm.collectionVariables.get(\"hashUnEnc\" ) );\r",
							"\r",
							"let hashV = crypto.enc.Base64.stringify(hashUnEnc);\r",
							"pm.collectionVariables.set(\"hashV\", hashV );\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
