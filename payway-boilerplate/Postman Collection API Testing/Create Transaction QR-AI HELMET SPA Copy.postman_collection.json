							"\r",
							"// let return_deeplinkV = \"eyJpb3Nfc2NoZW1lIjoiY2JjbW9iaWxlOi8vY2JjbW9iaWxlY2FsbGJhY2s\" ;\r",
							"// pm.collectionVariables.set(\"return_deeplinkV\", return_deeplinkV );\r",
							"// console.log(\"this is current email \" , pm.collectionVariables.get(  \"return_deeplinkV\" ) );\r",
							"\r",
							"\r",
							"//setting current price\r",
							"// let amountV =pm.variables.replaceIn('{{$randomPrice}}')\r",
							"let amountV = '0.01';\r",
							"pm.collectionVariables.set(\"amountV\", amountV );\r",
							"console.log(\"this is current amount value \" , pm.collectionVariables.get(  \"amountV\" ) );\r",
							"\r",
							"let return_urlV = \"aHR0cHM6Ly82MjkxZDdlMWNkMGM5MTkzMmI2OGRhYjcubW9ja2FwaS5pby9wdXNoYmFjay9hcGkvdjEvcmVzcG9uc2UvYW9m\";\r",
							"pm.collectionVariables.set(\"return_urlV\", return_urlV );\r",
							"\r",
							"\r",
							"\r",
							"// let lifetimeV = \"10\" ;\r",
							"// pm.collectionVariables.set(\"lifetimeV\", lifetimeV );\r",
							"//calculate hash\r",
							"let hashMsg = req_timeV + merchant_idV + tran_idV + amountV + payment_optionV + return_urlV.toString() ;\r",
							"pm.collectionVariables.set(\"hashMsg\", hashMsg );\r",
							"\r",
							"console.log( \"This is hash message\", pm.collectionVariables.get(\"hashMsg\" ) );\r",
							"\r",
							"let secret = '[REMOVED-HISTORICAL-7a0b4ee24441]'\r",
							"\r",
							"let crypto = require('crypto-js');\r",
							"\r",
							"let hashUnEnc = crypto.HmacSHA512(hashMsg , secret);\r",
							"pm.collectionVariables.set(\"hashUnEnc\", hashUnEnc );\r",
							"\r",
							"\r",
							"let hashV = crypto.enc.Base64.stringify(hashUnEnc);\r",
							"pm.collectionVariables.set(\"hashV\", hashV );\r",
							"\r",
							"\r",
							"\r",
							"//hashVf = CryptoJS.enc.Base64.stringify(hashVunEnc);\r",
							"console.log( \"This is hash Base encoded value \", pm.collectionVariables.get(\"hashV\" ) );\r",
