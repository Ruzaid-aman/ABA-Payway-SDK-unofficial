              "var C = pm.collectionVariables;",
              "var itemRaw = (C.get('items_json') || '').trim() || '[{\"name\":\"Subscription\",\"quantity\":1,\"price\":0.10}]';",
              "var itemsB64 = b64json(itemRaw);",
              "var ru = ensureB64(C.get('return_url') || 'https://example.com/return');",
              "var cu = ensureB64(C.get('cancel_url') || 'https://example.com/cancel');",
              "var su = ensureB64(C.get('continue_success_url') || 'https://example.com/success');",
              "var reqTime = utcNow();",
              "var tranId = genTranId();",
              "var amount = fmtAmt(C.get('amount'), C.get('currency'));",
              "var tokenFlag = 'CITR_FIX';",
              "var frequency = C.get('sub_frequency') || '1W';",
              "var lifetime = C.get('sub_lifetime') || '30';",
              "var msg = reqTime + C.get('merchant_id') + tranId + amount + itemsB64 + '' + '0'",
              "  + C.get('ctid') + '' + C.get('sub_firstname') + C.get('sub_lastname') + C.get('sub_email') + C.get('sub_phone')",
              "  + 'purchase' + (C.get('sub_payment_option') || 'abapay') + ru + cu + su + ''",
              "  + (C.get('currency') || 'USD') + '' + '' + '' + lifetime + '' + tokenFlag + frequency;",
              "C.set('request_time', reqTime);",
              "C.set('tran_id', tranId);",
              "C.set('sub_amount_fmt', amount);",
              "C.set('sub_items_b64', itemsB64);",
              "C.set('sub_ret_b64', ru);",
              "C.set('sub_can_b64', cu);",
              "C.set('sub_con_b64', su);",
              "C.set('computed_hash', hmac512(msg, C.get('secret_key')));",
              "console.log('b4hash:', msg);"
            ]
