          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"request_time\": \"{{request_time}}\",\n  \"merchant_id\":  \"{{merchant_id}}\",\n  \"ctid\":         \"{{ctid}}\",\n  \"pwt\":          \"{{pwt}}\",\n  \"hash\":         \"{{computed_hash}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payment-credential/v3/token-management/remove-token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment-credential",
            "v3",
            "token-management",
            "remove-token"
          ]
        },
        "description": "Flow B step 5 (final). ⚠️ Irreversibly removes the token and clears `{{pwt}}`. Ends Flow B."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Restore the shared PayWay helper library (Postman runs every script in its own scope):",
              "var __h = pm.collectionVariables.get('__helpers');",
              "if (!__h) throw new Error('The `__helpers` collection variable is missing - re-import the full collection JSON (it holds the shared helper library source).');",
              "eval(__h);",
              "var C = pm.collectionVariables;",
              "if (!C.get('pwt')) throw new Error('Set {{pwt}} first.');",
              "var reqTime = utcNow();",
              "var msg = C.get('merchant_id') + C.get('ctid') + reqTime + C.get('pwt');",
              "C.set('request_time', reqTime);",
              "C.set('computed_hash', hmac512(msg, C.get('secret_key')));",
              "console.log('b4hash:', msg);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "try {",
              "  var j = pm.response.json();",
              "  if (j.status) {",
              "    pm.test('status.code present', function () { pm.expect(j.status.code).to.not.be.empty; });",
              "    console.log('status.code:', j.status.code, '-', j.status.message || '');",
              "    if (String(j.status.code) === '00') {",
              "      console.log('Token removed. Clear {{pwt}} to avoid reusing a dead token.');",
              "      pm.collectionVariables.set('pwt', '');",
              "    }",
              "  }",
              "} catch (e) { console.log('Response was not JSON.'); }\npostman.setNextRequest(null); // end of Flow B"
            ]
          }
