          "raw": "{\n  \"req_time\": \"{{req_time}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"tran_id\": \"{{last_tran_id}}\",\n  \"hash\": \"{{computed_hash}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payment-gateway/v1/payments/transaction-detail",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment-gateway",
            "v1",
            "payments",
            "transaction-detail"
          ]
        },
        "description": "Flow A step 3. Pulls the full transaction record for `{{last_tran_id}}` (works for QR *and* card transactions). In the Runner it follows A2 automatically; standalone, just **Send**."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Restore the shared PayWay helper library (Postman runs every script in its own scope):",
              "var __h = pm.collectionVariables.get('__helpers');",
              "if (!__h) throw new Error('The `__helpers` collection variable is missing - re-import the full collection JSON (it holds the shared helper library source).');",
              "eval(__h);",
              "var C = pm.collectionVariables;",
              "var reqTime = utcNow();",
              "var tranId = C.get('last_tran_id') || C.get('tran_id');\nif (!tranId) throw new Error('No tran_id - run A1 first.');",
              "var msg = reqTime + C.get('merchant_id') + tranId;",
              "C.set('req_time', reqTime);",
              "C.set('computed_hash', hmac512(msg, C.get('secret_key')));",
              "console.log('b4hash:', msg);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Restore the shared PayWay helper library (Postman runs every script in its own scope):",
              "var __h = pm.collectionVariables.get('__helpers');",
              "if (!__h) throw new Error('The `__helpers` collection variable is missing - re-import the full collection JSON (it holds the shared helper library source).');",
              "eval(__h);",
              "var j = {};",
              "try { j = pm.response.json(); } catch (e) {}",
              "var sc = respCode(j);",
              "pm.test('Detail responded (status.code ' + sc + ')', function () { pm.expect(sc).to.not.be.empty; });",
              "if (sc === '0' || sc === '00') {",
              "  console.log('transaction record:', JSON.stringify(j.data).slice(0, 500));",
              "} else {",
              "  console.log('Business error', sc, '-', j.status && j.status.message);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "A4 - Refund",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"request_time\": \"{{request_time}}\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"merchant_auth\": \"{{computed_merchant_auth}}\",\n  \"hash\": \"{{computed_hash}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/merchant-portal/merchant-access/online-transaction/refund",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "merchant-portal",
            "merchant-access",
            "online-transaction",
            "refund"
          ]
        },
        "description": "Flow A step 4 (final). Refunds `{{last_tran_id}}` for `{{refund_amount}}` (RSA — node-forge or `{{refund_merchant_auth}}`). Ends Flow A: the Runner stops here (`setNextRequest(null)`)."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Restore the shared PayWay helper library (Postman runs every script in its own scope):",
              "var __h = pm.collectionVariables.get('__helpers');",
              "if (!__h) throw new Error('The `__helpers` collection variable is missing - re-import the full collection JSON (it holds the shared helper library source).');",
              "eval(__h);",
              "var C = pm.collectionVariables;",
              "var reqTime = utcNow();",
              "var tranId = C.get('last_tran_id') || C.get('tran_id');",
              "var auth = rsaFallback(JSON.stringify({mc_id: C.get('merchant_id'), tran_id: tranId, refund_amount: fmtAmt(C.get('refund_amount'))}), C.get('rsa_public_key'), 'refund_merchant_auth');",
              "var msg = reqTime + C.get('merchant_id') + auth;",
              "C.set('request_time', reqTime);",
              "C.set('computed_merchant_auth', auth);",
              "C.set('computed_hash', hmac512(msg, C.get('secret_key')));",
              "console.log('b4hash:', msg);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var j = pm.response.json();",
              "var code = j.statusCode || (j.status && j.status.code);",
              "pm.test('Refund responded (status ' + String(code) + ')', function () { pm.expect(String(code)).to.not.be.undefined; });\npostman.setNextRequest(null); // end of Flow A - do not bleed into Flow B"
            ]
          }
        }
      ]
    },
    {
      "name": "B1 - Link Account (Flow B)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"request_id\":     \"{{request_id}}\",\n  \"request_time\":   \"{{request_time}}\",\n  \"merchant_id\":    \"{{merchant_id}}\",\n  \"ctid\":           \"{{ctid}}\",\n  \"return_deeplink\": \"{{cof_return_deeplink_b64}}\",\n  \"token_flag\":     \"{{token_flag}}\",\n  \"currency\":       \"{{currency}}\",\n  \"callback_url\":   \"{{cof_callback_b64}}\",\n  \"hash\":           \"{{computed_hash}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payment-credential/v3/aof/link-account",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment-credential",
            "v3",
            "aof",
            "link-account"
          ]
        },
        "description": "Flow B step 1. Starts CoF account linking — generates `{{request_id}}` and returns a deeplink/QR (Visualize tab). Approve it in the ABA Mobile app, then let the Runner continue to B2 (or send B2 yourself)."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Restore the shared PayWay helper library (Postman runs every script in its own scope):",
              "var __h = pm.collectionVariables.get('__helpers');",
              "if (!__h) throw new Error('The `__helpers` collection variable is missing - re-import the full collection JSON (it holds the shared helper library source).');",
              "eval(__h);",
              "var C = pm.collectionVariables;",
              "var reqTime = utcNow();",
              "var requestId = genRequestId('REQ');",
              "var rdB64 = ensureB64(C.get('cof_return_deeplink'));",
              "var cbB64 = ensureB64(C.get('cof_callback_url'));",
              "var msg = C.get('merchant_id') + reqTime + C.get('ctid') + rdB64 + cbB64 + requestId + (C.get('token_flag')||'CITI_FLEX') + '' + '' + (C.get('currency')||'USD');",
              "C.set('request_id', requestId);",
              "C.set('request_time', reqTime);",
              "C.set('cof_return_deeplink_b64', rdB64);",
              "C.set('cof_callback_b64', cbB64);",
              "C.set('computed_hash', hmac512(msg, C.get('secret_key')));",
              "console.log('b4hash:', msg);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Restore the shared PayWay helper library (Postman runs every script in its own scope):",
              "var __h = pm.collectionVariables.get('__helpers');",
              "if (!__h) throw new Error('The `__helpers` collection variable is missing - re-import the full collection JSON (it holds the shared helper library source).');",
              "eval(__h);",
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "try {",
              "  var j = pm.response.json();",
              "  if (j.status) {",
              "    pm.test('status.code present', function () { pm.expect(j.status.code).to.not.be.empty; });",
              "    console.log('status.code:', j.status.code, '-', j.status.message || '');",
              "    if (String(j.status.code) === '00') {",
              "      console.log('Link approved. request_id =', pm.collectionVariables.get('request_id'), '(watch the callback for pwt)');",
              "    } else {",
              "      console.log('Non-success code. See error-code table in description. request_id =', pm.collectionVariables.get('request_id'));",
              "    }",
              "  }",
              "} catch (e) { console.log('Response is not JSON; likely a redirect page.'); }",
              "var vj = {}; try { vj = pm.response.json(); } catch (e) {}",
              "if (vj.data && (vj.data.qr_string || vj.data.qrString)) visualizeQr('', vj.data.qr_string || vj.data.qrString, 'Flow B - scan in ABA Mobile, approve, then B2 with request_id ' + pm.collectionVariables.get('request_id'));"
            ]
          }
        }
      ]
    },
