          },
          "raw": "{\n  \"request_time\": \"{{request_time}}\",\n  \"request_id\":   \"{{request_id}}\",\n  \"merchant_id\":  \"{{merchant_id}}\",\n  \"hash\":         \"{{computed_hash}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payment-credential/v3/token-management/get-token-details",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payment-credential",
            "v3",
            "token-management",
            "get-token-details"
          ]
